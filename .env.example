# Copy to .env. Never commit .env.
RAG_STORE=memory              # memory | pgvector
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
RAG_EMBEDDINGS=hash           # hash (offline) | gemini
RAG_EMBED_DIM=768             # 768 for gemini-embedding-001, 384 for hash
RAG_LLM=extractive            # extractive (offline) | gemini
RAG_LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=               # https://aistudio.google.com/apikey
